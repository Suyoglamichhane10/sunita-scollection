# =============================================================================
# Sunita'z Collection - Server Environment Variables
# Copy this file to `.env` and fill in your real values.
# NOTE: NEVER commit the real `.env` file to version control.
# =============================================================================

# --- General ---
NODE_ENV=development
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
# Comma-separated list of allowed CORS origins.
# Include your Vercel frontend URL, local dev URLs, and the backend URL itself.
FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://sunitacollection-frontend.vercel.app

# =============================================================================
# Production deployment notes (Node + PM2)
# -----------------------------------------------------------------------------
# 1. Set NODE_ENV=production to enable Express static-serving of the client
#    build (client/dist), rate limiting, and strict CSP headers.
# 2. Set FRONTEND_URL to your live domain (e.g. https://sunitas-collection.com)
#    for correct CORS / cookie behaviour.
# 3. Run the server with:
#       pm2 start server/ecosystem.config.cjs --env production
#    or use the deploy script:
#       bash scripts/deploy.sh
# 4. Ensure the client is built before starting:
#       cd client && npm run build
# 5. MongoDB must be reachable; set MONGO_URI to your production connection
#    string (Atlas or self-hosted). The server refuses to boot in production
#    without a valid MONGO_URI.
# =============================================================================

# --- Database ---
MONGO_URI=mongodb://localhost:27017/sunitas_collection

# --- Session ---
# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# --- Email (Nodemailer - use SMTP / Gmail App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Sunita'z Collection <your_email@gmail.com>"

# --- Cloudinary (REQUIRED IN PRODUCTION) ---
# Create a free account at https://cloudinary.com
# Get credentials from Dashboard -> Settings -> Access Keys
# ⚠️ REQUIRED IN PRODUCTION — without these, uploaded images will be DELETED on every Render restart.
# ⚠️ In development: falls back to local storage with warning.
# ⚠️ In production: uploads are REJECTED with a clear error.
# Get free credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# eSewa Payment Gateway
# =============================================================================
# Environment: test (RC) or live
#   test / RC  -> product code "EPAYTEST", secret "8gBm/:&EnhH.1/q" (eSewa RC)
#   live       -> your real eSewa merchant product code + secret
ESEWA_ENV=test

# eSewa merchant code (product code). RC uses "EPAYTEST".
ESEWA_PRODUCT_CODE=EPAYTEST

# eSewa secret key used for the HMAC-SHA256 signature.
# Obtain this value from eSewa; never commit a live secret.
ESEWA_SECRET_KEY=

# Optional overrides (defaults are auto-selected based on ESEWA_ENV):
# ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# =============================================================================
# FonePay Payment Gateway
# =============================================================================
# Environment: test (RC) or live
#   test / RC  -> use FonePay RC merchant credentials
#   live       -> your real FonePay merchant credentials
FONEPAY_ENV=test

# FonePay merchant credentials
FONEPAY_MERCHANT_ID=
FONEPAY_MERCHANT_SECRET=
FONEPAY_APP_ID=

# FonePay product code (defaults to PRODUCT_CODE for RC if not set)
FONEPAY_PRODUCT_CODE=

# Callback / redirect URLs (defaults to localhost dev URLs)
# FONEPAY_SUCCESS_URL=http://localhost:5173/payment-success
# FONEPAY_FAILURE_URL=http://localhost:5173/payment-failure
# FONEPAY_REDIRECT_URL=http://localhost:5173/payment/callback

# =============================================================================
# Stripe (optional - only if you use card payments)
# =============================================================================
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (from Stripe dashboard -> Webhooks -> <endpoint> -> Signing secret).
# Required for the webhook that finalizes Stripe orders.
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# WhatsApp Business API (Meta)
# =============================================================================
WHATSAPP_PHONE_NUMBER=your_whatsapp_business_phone_number_id
WHATSAPP_BUSINESS_TOKEN=your_whatsapp_business_access_token
WHATSAPP_ADMIN_NUMBER=9779768562128

# =============================================================================
# Facebook OAuth (optional)
# =============================================================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# =============================================================================
# Google OAuth (optional)
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match EXACTLY what's in Google Cloud Console "Authorized Redirect URIs"
# No trailing slash!
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# =============================================================================
# TikTok for Business
# =============================================================================
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_BUSINESS_ID=your_tiktok_business_id
