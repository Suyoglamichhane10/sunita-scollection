# ===== Server Configuration =====
NODE_ENV=development
PORT=5000

# ===== Frontend URL (for CORS, callbacks, email links) =====
FRONTEND_URL=http://localhost:5173

# ===== MongoDB =====
# Use MongoDB Atlas URI for production, or leave blank to use in-memory MongoDB for dev
MONGO_URI=
MONGODB_URI=

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ===== Cloudinary (image upload) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Stripe (card payments) =====
STRIPE_SECRET_KEY=

# ===== eSewa (Nepal) =====
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# ===== Khalti (Nepal) =====
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# ===== Email (Nodemailer) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Sunita's Collection

# ===== Seed =====
# Set to 'true' to create the default admin user on startup
SEED_ADMIN=true
