# Frontend Environment Variables
# In production (when the client is built with `npm run build`),
# VITE_API_URL should point to your live API URL.
#
# If using PM2 + Express to serve the client build (no Nginx):
#   VITE_API_URL=http://your_server_ip:5000/api
#
# If using Nginx as a reverse proxy:
#   VITE_API_URL=https://your_domain.com/api
VITE_API_URL=/api

# App Configuration
VITE_APP_NAME=Sunita's Collection
VITE_APP_VERSION=1.0.0

# Admin Access
VITE_ADMIN_EMAIL=admin@shopsync.com

# Socket.IO URL (set to your live wss:// URL when using Nginx)
# Leave empty to use same-origin (window.location.origin)
VITE_SOCKET_URL=
