# Frontend Environment Variables
#
# LOCAL DEVELOPMENT:
#   Vite dev server proxies /api to http://localhost:5000/api automatically.
#   Keep VITE_API_URL=/api — api.js falls back to /api in dev mode.
#
# PRODUCTION (Vercel frontend + Render backend):
#   Set this env var in the Vercel dashboard (Project Settings > Environment Variables):
#     VITE_API_URL=https://sunitacollection-backend.onrender.com/api
#   This must be an absolute URL to the Render backend.

# For production deployment, set this in the Vercel dashboard:
# VITE_API_URL=https://sunitacollection-backend.onrender.com/api
VITE_API_URL=/api

# App Configuration
VITE_APP_NAME=Sunita's Collection
VITE_APP_VERSION=1.0.0

# Admin Access
VITE_ADMIN_EMAIL=admin@shopsync.com

# Socket.IO URL (set to your live wss:// URL when using Nginx)
# Leave empty to use same-origin (window.location.origin)
VITE_SOCKET_URL=
